# ============================================================================
# NEO-UNO BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================

# Cổng lắng nghe của máy chủ Express & Socket.io
PORT=5001
NODE_ENV=development

# Chuỗi kết nối MongoDB (Local MongoDB hoặc MongoDB Atlas Cluster)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/neo_uno?retryWrites=true&w=majority

# Chuỗi khóa bí mật mã hóa JWT Token
JWT_SECRET=neo_uno_super_secret_jwt_key_2026_xyz

# Khóa Client ID xác thực Google OAuth2 (Tùy chọn)
GOOGLE_CLIENT_ID=59994646938-36p435cvpfrvf8r2uh0dg6ctfa0du2cg.apps.googleusercontent.com

# Cấu hình máy chủ gửi Email OTP (Nodemailer SMTP - Tùy chọn)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="NEO-UNO Security <noreply@neo-uno.game>"
